---
import SiteLayout from '../layouts/SiteLayout.astro';
import SidebarScene from '../components/SidebarScene.astro';

const steps = [
  {
    title: 'Kontext erkennen',
    text: 'AInnotate sieht, welche Windows-Anwendung, welches Fenster und welcher Bildschirm gerade aktiv ist – von der SAP-Transaktion bis zum Ordner im Explorer.',
  },
  {
    title: 'Wissen finden',
    text: 'Die passende Seite aus Ihren OneNote-Notizbüchern erscheint sofort. Diese Suche läuft lokal und braucht keinen KI-Aufruf.',
  },
  {
    title: 'Fragen und handeln',
    text: 'Sie fragen mit vollem Kontext. Auf Wunsch füllt die KI Felder aus, drückt Schaltflächen oder navigiert – jede Aktion bleibt sichtbar.',
  },
];

const features = [
  {
    title: 'Kontext statt Copy-and-paste',
    text: 'Keine Bildschirmfotos, kein Abtippen: AInnotate liest Fenster, Felder und Tabellen direkt aus der Anwendung.',
  },
  {
    title: 'Dokumentation am Arbeitsplatz',
    text: 'Persönliche und Team-Notizbücher werden nach Relevanz durchsucht. Die genaueste Seite gewinnt.',
  },
  {
    title: 'Aktionen nachvollziehen',
    text: 'Jede Aktion, die die KI ausführt, wird angezeigt. Einzelne Schritte lassen sich prüfen und gezielt wiederholen.',
  },
  {
    title: 'Prompts aus OneNote',
    text: 'Markierte Fragen werden zu Ein-Klick-Schaltflächen, markierte Hinweise steuern die KI im Hintergrund.',
  },
  {
    title: 'Gemeinsame Wissensbasis',
    text: 'PDF, Word, Excel oder ganze Notizbücher, inklusive Texterkennung in Bildern, als durchsuchbares Teamwissen.',
  },
  {
    title: 'Ergebnisse bleiben erhalten',
    text: 'Gespräche werden nach jeder Antwort in ein privates oder geteiltes Notizbuch geschrieben.',
  },
];

const plugins = [
  { kind: 'SAP · Frontend', name: 'SAP GUI', text: 'Bildschirme, Felder, Tabellen und ALV-Grids lesen und bedienen, Transaktionen starten. Notizbücher passend zu System und Mandant.' },
  { kind: 'SAP · Backend', name: 'SAP-System', text: 'Direkt am System: ABAP-Quelltexte, Klassen, Funktionsbausteine und Transporte untersuchen, Daten lesend per OpenSQL prüfen.' },
  { kind: 'Ticketsystem', name: 'Jira Cloud', text: 'Tickets in natürlicher Sprache finden, Details zusammenfassen und Kommentare verfassen.' },
  { kind: 'Desktop', name: 'Windows Explorer', text: 'Ordner verstehen, Dateien finden, umbenennen und direkt als Wissen bereitstellen.' },
  { kind: 'Dateien', name: 'Dateien und Excel', text: 'Dateien kopieren, umbenennen und speichern, Excel-Tabellen strukturiert auswerten.' },
  { kind: 'Browser', name: 'Firefox', text: 'Die aktuelle Webseite als Kontext nutzen, passende Notizen anzeigen und gezielt navigieren.' },
];

const desktop = [
  { title: 'Programme starten', text: 'Hinterlegte Startprofile öffnen Anwendungen mit den richtigen Parametern, ohne dass Sie Pfade oder Anmeldedaten suchen.' },
  { title: 'Fenster bedienen', text: 'Schaltflächen drücken, Felder und Tabellen füllen, Tastatureingaben senden und zwischen Bildschirmen navigieren.' },
  { title: 'Im richtigen Fenster arbeiten', text: 'Aufgaben lassen sich gezielt an ein geöffnetes Fenster binden, auch wenn mehrere Anwendungen gleichzeitig laufen.' },
  { title: 'Unter Ihrer Aufsicht', text: 'Jede Aktion erscheint in der Seitenleiste. Mit Kaldur entscheidet der Server, welche Aktionen eine Freigabe brauchen.' },
];
---

<SiteLayout
  title="AInnotate – KI-Seitenleiste für Windows mit OneNote-Wissen"
  description="AInnotate verbindet die aktive Windows-Anwendung, das Wissen Ihres Teams in OneNote und KI in einer Seitenleiste. Mit vielen Plugins, eigenständig oder zusammen mit Kaldur."
  page="home"
>
  <section class="hero">
    <div class="shell hero-copy-grid">
      <div>
        <p class="eyebrow">Windows · OneNote · KI</p>
        <h1><span>Ihre Anwendung.</span> <span>Ihr Wissen.</span> <span>Ihre KI.</span></h1>
        <p class="lead">
          AInnotate sitzt als Seitenleiste neben der Windows-Anwendung, mit der Sie gerade arbeiten. Es
          erkennt, wo Sie sind, zeigt die passende Dokumentation Ihres Teams aus OneNote und steuert auf
          Wunsch die laufenden Anwendungen auf Ihrem Desktop – besonders dort, wo Software komplex ist.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="#ablauf">So funktioniert’s <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="#plugins">Plugins ansehen</a>
        </div>
      </div>
      <aside class="hero-note">
        <p class="eyebrow">Gebaut für Windows</p>
        <strong>Windows 10 und 11</strong>
        <p>Arbeitet eigenständig auf Ihrem Rechner. Mit Kaldur verbunden, spielt AInnotate zusätzliche Stärken aus.</p>
      </aside>
    </div>
    <div class="hero-media">
      <div class="shell">
        <SidebarScene />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Warum AInnotate</p>
        <h2>Ein Chatbot weiß nicht, woran Sie arbeiten.</h2>
        <p class="lead">
          Wer komplexe Unternehmenssoftware bedient, kopiert Fehlermeldungen in Chatfenster, sucht
          Anleitungen in Wikis und erklärt der KI jedes Mal von vorn, was auf dem Bildschirm steht.
        </p>
      </div>
      <div class="quote-block">
        <p>AInnotate dreht das um: Das Wissen kommt zur Person – genau an die Stelle, an der es gebraucht wird.</p>
      </div>
    </div>
  </section>

  <section class="section" id="ablauf">
    <div class="shell">
      <div class="section-header">
        <div>
          <p class="eyebrow">So funktioniert’s</p>
          <h2>Drei Schritte. Kein Fensterwechsel.</h2>
        </div>
        <p class="lead">
          AInnotate verbindet drei Dinge, die sonst getrennt sind: die Anwendung, in der Sie arbeiten, das
          Wissen Ihres Teams und ein KI-Modell, das beides versteht.
        </p>
      </div>
      <ol class="feature-grid">
        {steps.map((step, index) => (
          <li class="feature-card">
            <span class="feature-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="funktionen">
    <div class="shell">
      <div class="section-header">
        <div>
          <p class="eyebrow">Funktionen</p>
          <h2>Für Menschen, die mit Wissen arbeiten.</h2>
        </div>
        <p class="lead">
          Vom ersten Blick auf den Bildschirm bis zur ausgeführten Aktion: AInnotate nimmt Ihnen das
          Suchen, Erklären und Abtippen ab.
        </p>
      </div>
      <ul class="feature-grid">
        {features.map((feature, index) => (
          <li class="feature-card">
            <span class="feature-index">{String(index + 4).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="desktop">
    <div class="shell split">
      <div>
        <p class="eyebrow">Desktop-Anwendungen steuern</p>
        <h2>Die KI bedient Ihre Anwendungen.</h2>
        <p class="lead">
          AInnotate beantwortet nicht nur Fragen. Über seine Plugins steuert es die Anwendungen, die auf
          Ihrem Desktop laufen – vom Start eines Programms bis zum ausgefüllten Formular.
        </p>
      </div>
      <ul class="row-list row-list-wide">
        {desktop.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark-section" id="plugins">
    <div class="shell">
      <div class="section-header">
        <div>
          <p class="eyebrow">Plugins</p>
          <h2>Viele Plugins. Und Ihre eigenen.</h2>
        </div>
        <p class="lead">
          Jedes Plugin macht eine Anwendung für AInnotate verständlich und steuerbar: Es liest deren
          Bildschirme und stellt der KI passende Werkzeuge bereit. Für SAP gibt es Plugins für das Frontend
          und das Backend.
        </p>
      </div>
      <ul class="feature-grid plugin-grid">
        {plugins.map((plugin) => (
          <li class="feature-card">
            <span class="feature-index">{plugin.kind}</span>
            <h3>{plugin.name}</h3>
            <p>{plugin.text}</p>
          </li>
        ))}
      </ul>

      <div class="own-plugins">
        <div class="own-plugins-head">
          <p class="eyebrow">Eigene Plugins</p>
          <h3>Entwickeln Sie Plugins in C# oder Python.</h3>
          <p>Was fehlt, binden Sie selbst an – auch Fachanwendungen, die nur in Ihrem Betrieb laufen.</p>
        </div>
        <div class="own-plugin-grid">
          <article class="feature-card feature-card-own">
            <span class="feature-index">C# · .NET</span>
            <h3>Tiefe Integration</h3>
            <p>Mit dem Plugin-SDK erkennt Ihr Plugin eigene Fenster, liest deren Inhalte und stellt Aktionen bereit, die die KI ausführen kann.</p>
          </article>
          <article class="feature-card feature-card-own">
            <span class="feature-index">Python</span>
            <h3>Schnell erweitert</h3>
            <p>Python-Plugins werden direkt zu Werkzeugen der KI – ideal, um Skripte, Datenquellen und Schnittstellen ohne C# anzubinden.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="kaldur">
    <div class="shell">
      <div class="section-header">
        <div>
          <p class="eyebrow">Eigenständig oder mit Kaldur</p>
          <h2>Allein stark. Zusammen stärker.</h2>
        </div>
        <p class="lead">
          AInnotate braucht keinen eigenen Server. Wer Kaldur einsetzt, verbindet beide und bekommt zentrale
          Verwaltung, geräteübergreifende Gespräche und serverseitige Kontrolle dazu.
        </p>
      </div>
      <div class="mode-grid">
        <article class="mode">
          <p class="eyebrow">Eigenständig</p>
          <h3>Alles auf Ihrem Rechner</h3>
          <p>AInnotate läuft vollständig auf dem Windows-Arbeitsplatz und spricht direkt mit dem KI-Anbieter Ihrer Wahl.</p>
          <ul>
            <li><strong>Ohne zusätzliche Infrastruktur</strong><span>Installieren, KI-Zugang eintragen, loslegen.</span></li>
            <li><strong>Lokale Wissenssuche</strong><span>OneNote wird auf dem Rechner durchsucht, die KI erst bei einer Frage kontaktiert.</span></li>
            <li><strong>Direkter Draht zum Modell</strong><span>OpenAI oder Azure OpenAI, mit verschlüsselt gespeicherten Schlüsseln.</span></li>
          </ul>
        </article>
        <article class="mode mode-kaldur">
          <p class="eyebrow">Mit Kaldur</p>
          <h3>Ihr Arbeitsplatz im Arbeitsraum</h3>
          <p>Verbunden mit einem Kaldur Server wird AInnotate zum Windows-Begleiter der Kaldur-Plattform.</p>
          <ul>
            <li><strong>Zugangsdaten bleiben zentral</strong><span>Schlüssel liegen auf dem Server und werden nie an Arbeitsplätze verteilt.</span></li>
            <li><strong>Gespräche auf allen Geräten</strong><span>Was in AInnotate beginnt, lässt sich in Kaldur im Web oder auf dem Smartphone fortsetzen.</span></li>
            <li><strong>Projektwissen aus Kaldur</strong><span>Antworten greifen auf das Wissen Ihrer Kaldur-Projekte zurück.</span></li>
            <li><strong>Kontrolle auf dem Server</strong><span>Berechtigungen und Freigaben für riskante Aktionen entscheidet der Server, nicht der Client.</span></li>
          </ul>
          <a class="text-link" href="https://kaldur.net">Kaldur kennenlernen <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">OneNote als Wissensbasis</p>
        <h2>Ihre Doku wird zur Bedienoberfläche.</h2>
        <p class="lead">
          Teams pflegen ihr Wissen dort weiter, wo es schon liegt. Kategorien in OneNote steuern, was die
          Seitenleiste anbietet und wie die KI arbeitet.
        </p>
      </div>
      <ul class="row-list">
        <li>
          <span><span class="tag tag-question">Frage</span></span>
          <p>Wird zur Schaltfläche in der Seitenleiste. Ein Klick stellt die Frage im aktuellen Kontext.</p>
        </li>
        <li>
          <span><span class="tag tag-hint">KI-Hinweis</span></span>
          <p>Wird der KI als Leitplanke mitgegeben, zum Beispiel Regeln oder Namenskonventionen des Teams.</p>
        </li>
        <li>
          <span><span class="tag tag-chat">Verlauf</span></span>
          <p>Gespräche landen als Seiten im Notizbuch und bleiben für das Team auffindbar.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Voraussetzungen</p>
        <h2>Schnell auf dem Arbeitsplatz.</h2>
        <p class="lead">AInnotate wird als signiertes Windows-Paket installiert und hält sich selbst aktuell.</p>
      </div>
      <ul class="row-list">
        <li><h3>System</h3><p>Windows 10 ab Version 2004 oder Windows 11, 64 Bit</p></li>
        <li><h3>Wissen</h3><p>OneNote für Windows für die Wissensfunktionen</p></li>
        <li><h3>KI</h3><p>Zugang zu OpenAI oder Azure OpenAI – oder ein Kaldur Server</p></li>
        <li><h3>Anwendungen</h3><p>Je nach Plugin, zum Beispiel SAP GUI mit aktivierter Skriptunterstützung</p></li>
      </ul>
    </div>
  </section>

  <section class="section contact" id="kontakt">
    <div class="shell split">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2>Sie möchten mehr erfahren?</h2>
        <p class="lead">
          Erzählen Sie uns, mit welchen Anwendungen Ihr Team arbeitet. Wir zeigen Ihnen, was AInnotate dort
          leisten kann.
        </p>
      </div>
      <div class="contact-card">
        <p class="eyebrow">Algion GmbH</p>
        <a href="mailto:kontakt@algion.net?subject=AInnotate">kontakt@algion.net</a>
        <a href="tel:+4952509947964">+49 5250 9947964</a>
        <p>AInnotate wird von der Algion GmbH in Delbrück entwickelt.</p>
      </div>
    </div>
  </section>
</SiteLayout>
