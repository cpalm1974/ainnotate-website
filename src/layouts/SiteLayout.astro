---
import { Picture } from 'astro:assets';
import signet from '../assets/ainnotate-signet.png';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'legal' | 'privacy';
  noindex?: boolean;
}

const { title, description, page, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const anchor = (id: string) => (page === 'home' ? `#${id}` : `/#${id}`);
const nav = [
  { label: 'So funktioniert’s', href: anchor('ablauf') },
  { label: 'Funktionen', href: anchor('funktionen') },
  { label: 'Plugins', href: anchor('plugins') },
  { label: 'Mit Kaldur', href: anchor('kaldur') },
];
const legal = [
  { id: 'legal', label: 'Impressum', href: '/impressum' },
  { id: 'privacy', label: 'Datenschutz', href: '/datenschutz' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ee" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AInnotate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="AInnotate Startseite">
          <Picture src={signet} formats={['avif', 'webp']} densities={[1, 2]} width={40} height={40} alt="" />
          <span><span class="brand-ai">AI</span>nnotate</span>
        </a>
        <nav class="primary-nav" aria-label="Hauptnavigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="contact-link" href={anchor('kontakt')}>Kontakt</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand brand-footer" href="/">
            <Picture src={signet} formats={['avif', 'webp']} densities={[1, 2]} width={40} height={40} alt="" />
            <span><span class="brand-ai">AI</span>nnotate</span>
          </a>
          <p>Die KI-Seitenleiste für Windows, die weiß, woran Sie gerade arbeiten.</p>
        </div>
        <div class="footer-column">
          <p class="eyebrow">Produkt</p>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="footer-column">
          <p class="eyebrow">Rechtliches</p>
          {legal.map((item) => <a href={item.href} aria-current={page === item.id ? 'page' : undefined}>{item.label}</a>)}
          <a href="https://kaldur.net" rel="external">Kaldur <span aria-hidden="true">↗</span></a>
          <a href="https://algion.net" rel="external">Hersteller: Algion GmbH <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Algion GmbH</span>
        <span>AInnotate für Windows</span>
      </div>
    </footer>
  </body>
</html>
